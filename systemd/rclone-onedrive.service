[Unit]
Description=Rclone OneDrive Mount
Documentation=https://rclone.org/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rclone mount onedrive:/ /home/mbluteau/work/onedrive \
    --network-mode \
    --vfs-cache-mode full \
    --dir-cache-time 72h \
    --poll-interval 15s
ExecStop=/usr/bin/fusermount3 -u /home/mbluteau/work/onedrive
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
